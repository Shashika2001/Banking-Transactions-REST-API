<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings used by CI. See the "Test with coverage" step in .github/workflows/ci.yml. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[BankingApi.*]*</Include>
          <Exclude>[BankingApi.UnitTests]*</Exclude>
          <!-- Generated EF Core migrations are not hand-written code. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
