# Local development values for docker compose. Copy this file to .env (which is gitignored):
#
#   cp .env.example .env
#
# These values are for running on your own machine only. Change them before using this anywhere else.
# Avoid ';' in passwords: they are embedded in a SQL Server connection string.

# SQL Server "sa" password: at least 8 characters with three of: uppercase, lowercase, digits, symbols.
MSSQL_SA_PASSWORD=Local-Dev-Sql-Pa55word!

# JWT HMAC signing key: at least 32 characters. Generate your own with: openssl rand -base64 48
JWT_SIGNING_KEY=local-dev-only-signing-key-replace-me-0123456789

# Admin account created on startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin-Demo-Password-1

# Password for the two demo customers (jane.doe@example.com, john.smith@example.com).
DEMO_USER_PASSWORD=Customer-Demo-Password-1
